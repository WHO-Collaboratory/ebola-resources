{"version":3,"kind":"Article","sha256":"c7fd67019de7821a59b6a58e7a5ae1192228bee66ee5c96147480593361d3c0d","slug":"evidence-synthesis","location":"/docs/resources/evidence-synthesis.md","dependencies":[],"frontmatter":{"title":"Evidence Synthesis","content_includes_title":false,"github":"https://github.com/WHO-Collaboratory/ebola-resources","source_url":"https://github.com/WHO-Collaboratory/ebola-resources/blob/main/docs/resources/evidence-synthesis.md","edit_url":"https://github.com/WHO-Collaboratory/ebola-resources/edit/main/docs/resources/evidence-synthesis.md","exports":[{"format":"md","filename":"evidence-synthesis.md","url":"/ebola-resources/build/evidence-synthesis-f858fec3b62168a9e91d1c3c2dd485ed.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Syntheses of the current BVD evidence base, alongside a live tracker of relevant literature and resources.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pmVDE3B7YG"}],"key":"X0FeJr4GuK"},{"type":"admonition","kind":"important","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Beta","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"zfpQ9JpKbv"}],"key":"HPFmnEdRBd"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"This page is in beta and still a work in progress. Please direct feedback to ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"BXcfod5hdJ"},{"type":"link","url":"mailto:Collaboratory@who.int","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Collaboratory@who​.int","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Pkw7JKCQMK"}],"urlSource":"mailto:Collaboratory@who.int","key":"r6eHLdpXPN"},{"type":"text","value":". This page is subject to the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"tol5pGGBa5"},{"type":"crossReference","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"disclaimer","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"UW0XTTaGlp"}],"identifier":"evidence-synthesis-page-bottom","label":"evidence-synthesis-page-bottom","kind":"div","template":"Div","resolved":true,"html_id":"evidence-synthesis-page-bottom","key":"F02lfbjXZB"},{"type":"text","value":" below.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"sOzOFBZIfk"}],"key":"cnRde2uOxc"}],"key":"G6b3K1UZqY"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Synthesized analyses","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"LNAImQh4CM"}],"identifier":"synthesized-analyses","label":"Synthesized analyses","html_id":"synthesized-analyses","implicit":true,"key":"WObG1NeTKo"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Curated syntheses organized by question. Each page sets out the underlying analyses, how they compare, and where knowledge gaps persist.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"zZI5DBJsYx"}],"key":"Kqz3DvJFwu"},{"type":"block","children":[{"type":"list","children":[{"type":"listItem","children":[{"type":"link","url":"/outbreak-size","internal":true,"children":[{"type":"text","value":"Outbreak Size","key":"dHCgsfDoZs"}],"urlSource":"/outbreak-size","key":"jWymMYnRgt"}],"key":"oUce9bS1d0"},{"type":"listItem","children":[{"type":"link","url":"/risk-of-spread","internal":true,"children":[{"type":"text","value":"Risk of Spread","key":"eIvhTIdbFW"}],"urlSource":"/risk-of-spread","key":"X04XjlhzSG"}],"key":"eiO2JoBQzo"}],"key":"jWkqtyN2eV"}],"data":{"part":"toc:children"},"key":"f9EmIj8sQb"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"This site is maintained by the Ebola Outbreak Analytics Community of Practice (CoP) within the ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"jBxRBUMeN3"},{"type":"link","url":"https://www.who.int/initiatives/collaboratory","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Collaboratory","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"trQppc24r1"}],"urlSource":"https://www.who.int/initiatives/collaboratory","key":"DZCAKrwhZQ"},{"type":"text","value":".","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"QfrcAQ4Vjt"}],"key":"aMy4IuFMzq"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Pages are updated within one working day of new or revised analyses appearing. Verify figures and interpretations against the referenced analyses before use in operational decisions.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"hrMOo00niu"}],"key":"Dnqd1D5Uvg"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Methods","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"whuwAHY0rI"}],"identifier":"methods","label":"Methods","html_id":"methods","implicit":true,"key":"tiNqkIimJn"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"These pages are produced by a semi-automated evidence-synthesis pipeline that pairs AI models with human review at each major checkpoint: one model reads each source analysis on its own and grounds every extracted claim in a verbatim quoted passage; a second model takes the resulting structured comparison as input, and drafts the narrative. Human analysts then review and edit the output to ensure accuracy and completeness prior to publishing.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"V63pX7C8FA"}],"key":"LYRE7xtwz6"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"strong","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Identifying analyses.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"lqz6PSdwBP"}],"key":"I1CgxQcp8b"},{"type":"text","value":" Analyses are identified through continuous monitoring of preprint servers, peer-reviewed publications, and grey literature. An analysis is included if it directly addresses the 2026 Bundibugyo virus disease (BVD) outbreak and provides a quantitative estimate relevant to a given topic (e.g., outbreak size, risk of spread). Each included source is logged, and if the authors later release an updated version, the newer version supersedes the earlier one.","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"GIzAPHNM5C"}],"key":"U5rz9yvMWo"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"strong","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Preparing the source text.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"FuxSbk97tX"}],"key":"k0N585Oazr"},{"type":"text","value":" Each source text, regardless of source type (e.g., PDF, HTML), is converted to Markdown. A human analyst then curates the converted file and removes sections that carry no evidentiary content, such as references, acknowledgments, author contributions, affiliations, and declarations of interest, to keep extraction focused and reduce the number of input tokens used.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"vGybmcvJ2C"}],"key":"Ai9Ek0jrwE"},{"type":"paragraph","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"strong","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Extracting structured evidence.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"rIodhGwKCV"}],"key":"UqSAqpEuIu"},{"type":"text","value":" The curated text is split into individually citeable units, one per sentence, and passed to Claude Sonnet 4.6. For each of a fixed set of dimensions (e.g., estimates, methods, limitations), the model answers from that one source alone and must ground every factual claim in a verbatim span of its text.","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"zvwGME6Msr"}],"key":"j31mf7vz0s"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"strong","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Synthesizing the narrative.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"Y7EMRi3JvX"}],"key":"layB69G5u6"},{"type":"text","value":" OpenAI’s GPT-5.5 model reads the dimensions extracted for each analysis and synthesizes the information, covering the state of the evidence, how the estimates compare and why they diverge, the key uncertainties and assumptions shared across analyses, what would most reduce that uncertainty, and what it implies for the response.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"YbbpmXuZ7o"}],"key":"TJwf3Yz8DG"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"strong","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Human review and publication.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"kLZPl4WDs3"}],"key":"OLwEMLdeGN"},{"type":"text","value":" Human analysts edit the draft for accuracy, completeness, and tone prior to publishing.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"dP9MLQRYyO"}],"key":"l13ne1XYbs"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"strong","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Limitations.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"iOeGfDs93S"}],"key":"TJn1OMp5tM"},{"type":"text","value":" This pipeline surfaces only publicly available analyses; works that have not been made public are not captured.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"wlskMiOYlK"}],"key":"UP2PgHXs4D"},{"type":"heading","depth":2,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Evidence tracker","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"aLZchLBo3B"}],"identifier":"evidence-tracker","label":"Evidence tracker","html_id":"evidence-tracker","implicit":true,"key":"B19aj21lih"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"A live list of BVD literature and resources for modelers, epidemiologists, public health analysts, and others supporting the response. Peer-reviewed publications, preprints, GitHub repositories, datasets, and tools are captured. Refreshed twice per day.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"beqIN4d2gO"}],"key":"pHQZQKoJwk"},{"type":"admonition","kind":"seealso","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Access the live list","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"qqpq5UP2hE"}],"key":"GdInzpTGIM"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"link","url":"https://docs.google.com/spreadsheets/d/1ryymcAzIfZnQL3H79H2bJBdnIzRTHIFUnyt-6zkC4_U/edit?gid=118635632#gid=118635632","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Bundibugyo Ebolavirus Disease Literature","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"U49qlyEx2h"}],"urlSource":"https://docs.google.com/spreadsheets/d/1ryymcAzIfZnQL3H79H2bJBdnIzRTHIFUnyt-6zkC4_U/edit?gid=118635632#gid=118635632","key":"laoyJ11UJ6"}],"key":"LOiHzqQNmo"}],"key":"ygkbECkCjV"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Records are pulled from the WHO ","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"miP2Sxy2gw"},{"type":"link","url":"https://www.who.int/initiatives/eios","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Epidemic Intelligence from Open Sources (EIOS)","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"GzKIZ7Jn8R"}],"urlSource":"https://www.who.int/initiatives/eios","key":"AV181A1sAC"},{"type":"text","value":" platform, which aggregates content from bioRxiv, Crossref, DataCite, Europe PMC, medRxiv, OpenAlex, PubMed, Semantic Scholar, and other feeds. Direct community submissions are also included.","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"Wt6jpXcj98"}],"key":"KGpW70iL1B"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Sp