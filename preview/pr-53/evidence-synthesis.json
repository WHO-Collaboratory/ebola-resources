{"version":3,"kind":"Article","sha256":"122e6f91141ffda11821f052ed24e11e928106be1de81ef20de5ac024dce47d6","slug":"evidence-synthesis","location":"/docs/resources/evidence-synthesis.md","dependencies":[],"frontmatter":{"title":"Evidence Synthesis","content_includes_title":false,"github":"https://github.com/WHO-Collaboratory/ebola-resources","source_url":"https://github.com/WHO-Collaboratory/ebola-resources/blob/main/docs/resources/evidence-synthesis.md","edit_url":"https://github.com/WHO-Collaboratory/ebola-resources/edit/main/docs/resources/evidence-synthesis.md","exports":[{"format":"md","filename":"evidence-synthesis.md","url":"/ebola-resources/preview/pr-53/build/evidence-synthesis-96e44fa369a3ddce4ccf7aafdaf8a181.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Syntheses of the current BVD evidence base, alongside a live tracker of relevant literature and resources.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wUMQHEGwNz"}],"key":"eeNoMFFyDg"},{"type":"admonition","kind":"important","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Beta","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Rrms5ysngd"}],"key":"QxVurLWPh6"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"This page is in beta and still a work in progress. Please direct feedback to ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"js36TlEOSx"},{"type":"link","url":"mailto:Collaboratory@who.int","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Collaboratory@who​.int","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"nmhosOqg0u"}],"urlSource":"mailto:Collaboratory@who.int","key":"yL3KIPhHSP"},{"type":"text","value":". This page is subject to the ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"L0XqrOLtw5"},{"type":"crossReference","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"disclaimer","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"OGywPQiRbu"}],"identifier":"evidence-synthesis-page-bottom","label":"evidence-synthesis-page-bottom","kind":"div","template":"Div","resolved":true,"html_id":"evidence-synthesis-page-bottom","key":"A7r9L2Zp9V"},{"type":"text","value":" below.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"XbY9G5ubFS"}],"key":"JaAWD7ExAl"}],"key":"cT9CQLNB2M"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Synthesized analyses","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"uIXwqOVxLj"}],"identifier":"synthesized-analyses","label":"Synthesized analyses","html_id":"synthesized-analyses","implicit":true,"key":"MWLBy4P4wf"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Curated syntheses organized by question. Each page sets out the underlying analyses, how they compare, and where knowledge gaps persist.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"hAxPYkntFh"}],"key":"dY0d0nH4IF"},{"type":"admonition","kind":"hint","children":[{"type":"admonitionTitle","children":[{"type":"link","url":"/outbreak-size","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Outbreak Size","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"uQGxaSNJYK"}],"urlSource":"outbreak-size.md","dataUrl":"/outbreak-size.json","internal":true,"protocol":"file","key":"xG8smyxkI1"},{"type":"text","value":": At a glance","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"Hbk3yN6vYm"}],"key":"kkk55dWC92"},{"type":"include","file":"_glance/outbreak-size.md","literal":false,"lang":"markdown","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Reported case counts still understate true infections, with the gap holding roughly steady. The under-ascertainment ratio stands at 1.6–3.3× against 8,978 confirmed cases as of 10 October, based on a 90% credible interval of 14,028–29,258 cumulative infections. Ten separate analyses suggest persistent under-detection, with moderate confidence that under-detection persists at a roughly stable level.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MLYAawmDu3"}],"key":"IoHowRQqne"}],"key":"brMwrqWq8G"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"link","url":"/outbreak-size","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Read the full synthesis","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"LpMAFnsxuK"}],"urlSource":"outbreak-size.md","dataUrl":"/outbreak-size.json","internal":true,"protocol":"file","key":"IziTex9Osl"}],"key":"oAwQ2o3USm"}],"key":"IDtYUMqHPM"},{"type":"admonition","kind":"hint","children":[{"type":"admonitionTitle","children":[{"type":"link","url":"/risk-of-spread","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Risk of Spread","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"FZeHMuJTwg"}],"urlSource":"risk-of-spread.md","dataUrl":"/risk-of-spread.json","internal":true,"protocol":"file","key":"QIDM1b4Zjh"},{"type":"text","value":": At a glance","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"eXNM0pPPpD"}],"key":"bWTLN06zVc"},{"type":"include","file":"_glance/risk-of-spread.md","literal":false,"lang":"markdown","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Nearby countries, particularly Uganda, South Sudan, Rwanda, Kenya, Tanzania, face the highest near-term risk of imported Bundibugyo virus cases from the DRC. Rankings for more distant countries vary across analyses, driven by differences in how each model treats air travel, land travel, and the assumed spatial distribution of source cases. Evidence suggests that surveillance is best concentrated on the highest-probability importation routes. Confidence is moderate, with relative destination rankings holding up better across analyses than the absolute probabilities attached to them.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"b0qQmwPY45"}],"key":"hxYTz4ufhJ"}],"key":"BXh0zcxwsA"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"link","url":"/risk-of-spread","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Read the full synthesis","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"dmlmo8fF8S"}],"urlSource":"risk-of-spread.md","dataUrl":"/risk-of-spread.json","internal":true,"protocol":"file","key":"DTrD7QJbSy"}],"key":"MJ0yXrnU8w"}],"key":"v0AUo8kFcp"},{"type":"paragraph","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"This site is maintained by the Ebola Outbreak Analytics Community of Practice (CoP) within the ","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"D9bgmato6V"},{"type":"link","url":"https://www.who.int/initiatives/collaboratory","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Collaboratory","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"mMZQxNw6Lz"}],"urlSource":"https://www.who.int/initiatives/collaboratory","key":"ayXKJl814i"},{"type":"text","value":".","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"dtPMZhGOP8"}],"key":"TSoZww8S0m"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Pages are updated within one working day of new or revised analyses appearing. Verify figures and interpretations against the referenced analyses before use in operational decisions.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"j1MKqAA7AV"}],"key":"g07qaWgPQA"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"Methods","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Mn34MuAINK"}],"identifier":"methods","label":"Methods","html_id":"methods","implicit":true,"key":"ZzLAjk40Vy"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"These pages are produced by a semi-automated evidence-synthesis pipeline that pairs AI models with human review at each major checkpoint: one model reads each source analysis on its own and grounds every extracted claim in a verbatim quoted passage; a second model takes the resulting structured comparison as input, and drafts the narrative. Human analysts then review and edit the output to ensure accuracy and completeness prior to publishing.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"GhcyBtnlds"}],"key":"eb3myg0chB"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"strong","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"Identifying analyses.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"eDd91fAzpa"}],"key":"OUKpewmJix"},{"type":"text","value":" Analyses are identified through continuous monitoring of preprint servers, peer-reviewed publications, and grey literature. An analysis is included if it directly addresses the 2026 Bundibugyo virus disease (BVD) outbreak and provides a quantitative estimate relevant to a given topic (e.g., outbreak size, risk of spread). Each included source is logged, and if the authors later release an updated version, the newer version supersedes the earlier one.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"LYDz8Ojpxq"}],"key":"OYPuDFG28F"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"strong","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Preparing the source text.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"XPfHnsykhZ"}],"key":"wAVcI5LWsy"},{"type":"text","value":" Each source text, regardless of source type (e.g., PDF, HTML), is converted to Markdown. A human analyst then curates the converted file and removes sections that carry no evidentiary content, such as references, acknowledgments, author contributions, affiliations, and declarations of interest, to keep extraction focused and reduce the number of input tokens used.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"lwtOFE1Nil"}],"key":"Ral16HrhnY"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"strong","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Extracting structured evidence.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"ZY3bA65xqg"}],"key":"B2zs3QLYYF"},{"type":"text","value":" The curated text is split into individually citeable units, one per sentence, and passed to Claude Sonnet 4.6. For each of a fixed set of dimensions (e.g., estimates, methods, limitations), the model answers from that one source alone and must ground every factual claim in a verbatim span of its text.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"jiQgs5ScKH"}],"key":"yF4J2O99Vx"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"strong","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Synthesizing the narrative.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"FbLDxzVPEp"}],"key":"z2keqUhtHD"},{"type":"text","value":" OpenAI’s GPT-5.5 model reads the dimensions extracted for each analysis and synthesizes the information, covering the state of the evidence, how the estimates compare and why they diverge, the key uncertainties and assumptions shared across analyses, what would most reduce that uncertainty, and what it implies for the response.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"KE0U7drnDT"}],"key":"Cc7yEKKo9r"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"strong","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Human review and publication.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"ypMF5Rgsiz"}],"key":"BMj1DE7JRB"},{"type":"text","value":" Human analysts edit the draft for accuracy, completeness, and tone prior to publishing.","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"R4KDjxwgfz"}],"key":"bXIS8YHOhN"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"strong","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Limitations.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"lZ1pdxcGyU"}],"key":"P6z7OvrO4c"},{"type":"text","value":" This pipeline surfaces only publicly available analyses; works that have not been made public are not captured.","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"CtUL0gO8cR"}],"key":"ZHGhAefCJq"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Evidence tracker","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"obDsCyJiQx"}],"identifier":"evidence-tracker","label":"Evidence tracker","html_id":"evidence-tracker","implicit":true,"key":"yGPKq5RWC9"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"A live list of BVD literature and resources for modelers, epidemiologists, public health analysts, and others supporting the response. Peer-reviewed publications, preprints, GitHub repositories, datasets, and tools are captured. Refreshed twice per day.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"zSaHlGy6f1"}],"key":"dtMYrgodyn"},{"type":"admonition","kind":"seealso","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Access the live list","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"C7SqDmc4Mh"}],"key":"Yuvm48UgI3"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"link","url":"https://docs.google.com/spreadsheets/d/1ryymcAzIfZnQL3H79H2bJBdnIzRTHIFUnyt-6zkC4_U/edit?gid=118635632#gid=118635632","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Bundibugyo Ebolavirus Disease Literature","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"c4pA9JrMKo"}],"urlSource":"https://docs.google.com/spreadsheets/d/1ryymcAzIfZnQL3H79H2bJBdnIzRTHIFUnyt-6zkC4_U/edit?gid=118635632#gid=118635632","key":"SiGJxrICfF"}],"key":"WJUrfAead4"}],"key":"GhrFWKXYsD"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Records are pulled from the WHO ","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"HCOQkyyvkZ"},{"type":"link","url":"https://www.who.int/initiatives/eios","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Epidemic Intelligence from Open Sources (EIOS)","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"qa2xU9aGTH"}],"urlSource":"https://www.who.int/initiatives/eios","key":"AiA4kpRGD4"},{"type":"text","value":" platform, which aggregates content from bioRxiv, Crossref, DataCite, Europe PMC, medRxiv, OpenAlex, PubMed, Semantic Scholar, and other feeds. Direct community submissions are also included.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"EZR9GK9KeY"}],"key":"YxOvES2RTm"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Spot something missing? Add it to the ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"He4mYptPdP"},{"type":"link","url":"https://docs.google.com/spreadsheets/d/1ryymcAzIfZnQL3H79H2bJBdnIzRTHIFUnyt-6zkC4_U/edit?usp=sharing","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"inlineCode","value":"Community_Submissions","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"lQYcrmXmkp"}],"urlSource":"https://docs.google.com/spreadsheets/d/1ryymcAzIfZnQL3H79H2bJBdnIzRTHIFUnyt-6zkC4_U/edit?usp=sharing","key":"MvTf97BT09"},{"type":"text","value":" tab, or email ","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"AQDOk9BaRu"},{"type":"link","url":"mailto:collaboratory@who.int","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"collaboratory@who​.int","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"dbcklZyUOi"}],"urlSource":"mailto:collaboratory@who.int","key":"jvuLrpSYDd"},{"type":"text","value":" with additions, corrections, or gaps.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"qADYMRCxCC"}],"key":"PsigmiBWMB"},{"type":"div","label":"evidence-synthesis-page-bottom","identifier":"evidence-synthesis-page-bottom","html_id":"evidence-synthesis-page-bottom","key":"EFgoIHz1F1"}],"key":"a8Rfb7heOa"}],"key":"vvCbPSXCHf"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Ebola Outbreak Analytics - CoP Resources","url":"/","group":"Ebola Outbreak Analytics - CoP Resources"},"next":{"title":"Outbreak Size","short_title":"↳ Outbreak Size","url":"/outbreak-size","group":"Ebola Outbreak Analytics - CoP Resources"}}},"domain":"http://localhost:3000"}